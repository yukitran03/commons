# Copy to .env.local for local runs. Never commit real values.

# NEAR (testnet by default)
NEAR_NETWORK=testnet
# Leave empty for FastNEAR. rpc.*.near.org is deprecated and rate limited.
NEAR_RPC_URL=
DAO_FACTORY=sputnikv2.testnet
# Pays for new member accounts and DAO creation. Member accounts are <name>.<SPONSOR_ACCOUNT_ID>.
SPONSOR_ACCOUNT_ID=your-sponsor.testnet
SPONSOR_PRIVATE_KEY=ed25519:replace-me
# The bot's own account. Each DAO gives it the "proposer" role only.
BOT_ACCOUNT_ID=your-bot.testnet
BOT_PRIVATE_KEY=ed25519:replace-me

# Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAFakeTokenForExampleOnly
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
TELEGRAM_BOT_USERNAME=commons_near_bot
# Short name of the Mini App registered with @BotFather (/newapp). Leave empty to use plain links.
TELEGRAM_APP_SHORT_NAME=app

# Web
APP_URL=http://localhost:3000
# Neon Postgres URL in production. Locally: pglite:./data/dev keeps data across restarts; empty means in-memory.
DATABASE_URL=

# Optional: 1Click JWT (lower fees). Quotes work without it.
ONECLICK_JWT=
